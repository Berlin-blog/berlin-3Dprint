{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(login|register|custom|orders|messages|admin)", "dest": "/public/index.html" },
    { "src": "/product/(.*)", "dest": "/public/index.html" },
    { "src": "/admin/(.*)", "dest": "/public/index.html" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
